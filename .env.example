# Frontend Camp Environment Variables

# Supabase (PostgreSQL Database & Authentication)
# Get these keys in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Base Path (if deploying under a subfolder, e.g. /frontend-camp)
# NEXT_PUBLIC_BASE_PATH=/frontend-camp
